# syntax=docker/dockerfile:1
# Imagem de serving da API de recomendação (FastAPI + Uvicorn) para AWS Lambda.
# Usa o aws-lambda-web-adapter: expõe a app HTTP normal como função Lambda sem
# reescrever a API no formato de handler do Lambda. Free tier: 1M
# requisições/mês + 400.000 GB-s de execução, para sempre (não expira em 12
# meses, ao contrário do free tier "clássico" de EC2).

FROM python:3.12-slim AS builder
ENV PIP_NO_CACHE_DIR=1 POETRY_NO_INTERACTION=1 POETRY_VIRTUALENVS_IN_PROJECT=1
WORKDIR /app
RUN pip install "poetry>=1.8"
COPY pyproject.toml poetry.lock ./
RUN poetry install --only main --no-root
COPY src ./src
COPY configs ./configs
RUN poetry install --only main

FROM python:3.12-slim AS runtime
ENV PYTHONUNBUFFERED=1 PATH="/app/.venv/bin:$PATH"
WORKDIR /app

# Lambda Web Adapter: encaminha o invoke do Lambda para o Uvicorn na porta
# 8080, igual a um servidor HTTP comum. Espera o /health responder antes de
# liberar tráfego (evita erro no cold start enquanto o modelo carrega).
COPY --from=public.ecr.aws/awsguru/aws-lambda-adapter:1.0.1 /lambda-adapter /opt/extensions/lambda-adapter
ENV PORT=8080
ENV AWS_LWA_READINESS_CHECK_PATH=/health

COPY --from=builder /app/.venv /app/.venv
COPY --from=builder /app/src ./src
COPY --from=builder /app/configs ./configs

# Modelo embutido (imagem self-contained): a API carrega models/mlp.pt local
# no startup, sem depender de um servidor MLflow. Gere os artefatos com
# `dvc repro` antes do build. (Ver Dockerfile.serve.dockerignore.)
COPY models/mlp.pt ./models/mlp.pt
COPY data/processed/dims.json ./data/processed/dims.json

EXPOSE 8080
CMD ["uvicorn", "recsys.serving.api:app", "--host", "0.0.0.0", "--port", "8080"]
